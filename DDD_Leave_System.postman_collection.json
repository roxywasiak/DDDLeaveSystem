        {
          "name": "Cancel Leave (Employee)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// First create a new leave to cancel",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/leaves',",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Content-Type': 'application/json',",
                  "        'Authorization': 'Bearer ' + pm.collectionVariables.get('employeeToken')",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({type:'SICK',startDate:'2026-07-01',endDate:'2026-07-03',reason:'Flu'})",
                  "    }",
                  "}, function(err, res) {",
                  "    pm.collectionVariables.set('leaveId', res.json().id);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status is CANCELLED', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.equal('CANCELLED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveId}}", "cancel"]
            }
          }
        },
        {
          "name": "Reject Leave (Manager)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/leaves',",
                  "    method: 'POST',",
                  "    header: {",
                  "        'Content-Type': 'application/json',",
                  "        'Authorization': 'Bearer ' + pm.collectionVariables.get('employeeToken')",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({type:'UNPAID',startDate:'2026-08-01',endDate:'2026-08-10',reason:'Personal'})",
                  "    }",
                  "}, function(err, res) {",
                  "    pm.collectionVariables.set('leaveId', res.json().id);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status is REJECTED', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.equal('REJECTED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveId}}", "reject"]
            }
          }
        }
