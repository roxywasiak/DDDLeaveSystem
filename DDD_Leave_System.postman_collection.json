    {
      "name": "Leaves - Commands",
      "item": [
        {
          "name": "Apply for Leave",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Leave created with PENDING status', function() {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.equal('PENDING');",
                  "    pm.expect(json.type).to.equal('ANNUAL');",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.collectionVariables.set('leaveId', json.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ANNUAL\",\n  \"startDate\": \"2026-06-01\",\n  \"endDate\": \"2026-06-05\",\n  \"reason\": \"Family holiday\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leaves",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves"]
            }
          }
        },
        {
          "name": "Apply Leave - Invalid Dates (invalid)",
          "event": [
            {
